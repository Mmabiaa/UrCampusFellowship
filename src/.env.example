# Supabase Public Keys (Safe to expose to browser)
# Replace these with your actual keys from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-jwt-anon-key

# Supabase Server Key (NEVER expose to browser. Used for Admin API scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google SMTP Configuration (for sending emails)
# Get your App Password from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=your-gmail@gmail.com
